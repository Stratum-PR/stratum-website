# Sanity CMS Configuration
# Get your Project ID from: https://www.sanity.io/manage
VITE_SANITY_PROJECT_ID=your_project_id_here
VITE_SANITY_DATASET=production

# Resend Email Service
# Get your API key from: https://resend.com/api-keys
# (Use RESEND_API_KEY in Vercel for server-side; do not use VITE_ prefix for secrets)
RESEND_API_KEY=your_resend_api_key_here

# Unsubscribe link signing (required for welcome emails and /api/unsubscribe)
# Generate a random string, e.g. openssl rand -hex 32
UNSUBSCRIBE_SECRET=your_unsubscribe_secret_here

# Internal email sends (checklist, admin, notifications). Required for /api/send-checklist-email
# and for any server-side call to /api/send-email with type other than welcome/contact.
# Generate a random string, e.g. openssl rand -hex 32
INTERNAL_EMAIL_SECRET=your_internal_email_secret_here

# Admin email for notifications (e.g. new blog subscription). Defaults to contact@stratumpr.com
# ADMIN_EMAIL=contact@stratumpr.com

# Upstash Redis (optional) - for API rate limiting. Use a dedicated DB for this app.
# If not set, rate limiting is skipped.
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_token_here

# Instructions:
# 1. Copy this file to .env (or .env.local)
# 2. Replace "your_project_id_here" with your actual Sanity Project ID
# 3. Replace "your_resend_api_key_here" with your actual Resend API key
# 4. Restart Sanity Studio: npx sanity start
